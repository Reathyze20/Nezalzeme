# ==============================================================================
# Nezalžeme.cz — Konfigurace API klíčů
# ==============================================================================

# Google Gemini API klíč (získejte na https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# GOOGLE_API_KEY= (alternativní název pro Gemini)

# Hlídač Státu API token (získejte na https://www.hlidacstatu.cz/api/v2)
HLIDAC_STATU_TOKEN=

# Firecrawl API klíč — jen pro interní novinářský nástroj (pipeline/journalist_tool.py,
# /interni/prehled), nikdy pro veřejný export
FIRECRAWL_API_KEY=

# Volitelný model Gemini (výchozí: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# Alternativně: Anthropic API klíč (pokud používáte Claude)
# ANTHROPIC_API_KEY=

# HTTP Basic Auth pro /interni/* (novinářský nástroj) — bez obou proměnných
# je route uzamčená napevno (fail closed), viz middleware.ts
INTERNAL_TOOL_USER=
INTERNAL_TOOL_PASSWORD=
